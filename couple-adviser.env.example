# ── Couple Adviser — szablon konfiguracji backendu ───────────────────────────
# Skopiuj ten plik do `couple-adviser.env` i uzupełnij wartości.
# (couple-adviser.env jest prywatny / gitignored; ten szablon można commitować.)
# ─────────────────────────────────────────────────────────────────────────────

# mock → zero tokenów (domyślnie) | anthropic → realny model claude-sonnet-4-6
ADVISOR=mock

# Wymagany tylko gdy ADVISOR=anthropic (https://console.anthropic.com → API Keys)
# ANTHROPIC_API_KEY=sk-ant-...
