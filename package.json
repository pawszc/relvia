{
  "name": "couple-adviser",
  "version": "0.0.0",
  "private": true,
  "description": "Couple Adviser — backend (CAP/Node). NIE jest produktem SAP; nie korzysta z BTP.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69",
    "@cap-js/sqlite": "^1",
    "@sap/cds": "^8",
    "dotenv": "^17.4.2",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8"
  },
  "scripts": {
    "deploy": "cds deploy",
    "watch": "cds watch",
    "start": "cds-serve",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:int": "node --test \"test/integration/**/*.test.js\"",
    "test:all": "npm test && npm run test:int && npm --prefix web test",
    "test:eval": "node test/eval/run-eval.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "overrides": {
    "better-sqlite3": "^12"
  }
}
