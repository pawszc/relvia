# ── relvia — szablon konfiguracji backendu ───────────────────────────
# Skopiuj ten plik do `relvia.env` i uzupełnij wartości.
# (relvia.env jest prywatny / gitignored; ten szablon można commitować.)
# ─────────────────────────────────────────────────────────────────────────────

# mock → zero tokenów (domyślnie) | anthropic → realny model
ADVISOR=mock

# Który model (gdy ADVISOR=anthropic) — id z srv/advisor/models.js:
# claude-haiku-4-5 (domyślny) | claude-sonnet-4-6 | claude-opus-4-8 | claude-opus-4-7 | claude-opus-4-6 | claude-fable-5
ADVISOR_MODEL=claude-haiku-4-5

# Wymagany tylko gdy ADVISOR=anthropic (https://console.anthropic.com → API Keys)
# ANTHROPIC_API_KEY=sk-ant-...

# ── Ochrona kosztu (config.js — wszystkie progi tu, opcjonalne) ───────────────
# ADVISOR_BUDGET_USD=0.50            # budżet per konwersacja (read-only po przekroczeniu)
# ADVISOR_GLOBAL_BUDGET_USD=20       # globalny dzienny limit całej aplikacji (ostatnie 24h)
# ADVISOR_CACHE_TTL=5m               # prompt caching decide: 5m (domyślny) | 1h
# ADVISOR_RATELIMIT_MIN_MS=1500      # min. odstęp między wiadomościami w konwersacji

# ── Testy live i18n (OPT-IN, płatne — nigdy nie odpalają się same) ────────────
# RUN_LIVE_AI_TESTS=true npm run test:ai:i18n:live → maks. 3 wywołania modelu,
# twardy limit 3.00 USD (LIVE_AI_BUDGET_USD może go tylko OBNIŻYĆ, nie podnieść).
# RUN_LIVE_AI_TESTS=true
# LIVE_AI_BUDGET_USD=3

# ── Capability tokeny (hash w spoczynku) ──────────────────────────────────────
# Stabilny sekret do HMAC capability tokenów. Minimum 32 bajty.
# Wygeneruj raz; nie zmieniaj przy każdym deployu (zmiana unieważnia sesje):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# WYMAGANY przy włączonej kontroli dostępu (domyślnie ON) — bez niego serwer
# celowo NIE wystartuje. Nigdy nie commituj wartości i nie wpisuj jej do fly.toml.
# CAPABILITY_TOKEN_PEPPER=

# ── AdminService /admin (widok operacyjny bazy przez OData, bez credentiali) ──
# Ustaw, by WŁĄCZYĆ /admin. Bez tego /admin oddaje 503 (wyłączony).
# Dostęp: Authorization: Bearer <ADMIN_API_KEY>. Użyj długiego, losowego sekretu.
# ADMIN_API_KEY=
